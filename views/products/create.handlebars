<section class="form-page">
    <div class="form-intro">
        <span class="eyebrow">Products</span>
        <h1>Bring your<br><em>idea</em> to life.</h1>
        <p>Register a new product and become part of our curated collection of special objects.</p>
        <a class="back-link" href="/products">← Back to products</a>
    </div>

    <form action="/products/create" method="POST" class="product-form">
        <div class="form-header">
            <span>01</span>
            <h2>New product</h2>
        </div>

        <div class="form-control">
            <label for="name">Product name</label>
            <input id="name" type="text" name="name" placeholder="Ex: Luma Lamp" required>
        </div>

        <div class="form-control">
            <label for="image">Product image</label>
            <input id="image" type="url" name="image" placeholder="https://..." required>
        </div>

        <div class="form-control">
            <label for="price">Price</label>
            <input id="price" type="text" name="price" placeholder="Ex: 100$" required>
        </div>

        <div class="form-control">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Tell us about your product..." required></textarea>
        </div>

        <button type="submit" class="btn">
            Publish product <span aria-hidden="true">↗</span>
        </button>
    </form>
</section>
