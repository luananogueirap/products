<div class="catalog-page">
    <section class="catalog-hero">
        <div class="catalog-copy">
            <span class="eyebrow">Product collection</span>
            <h1>Objects that<br><em>illuminate</em> your home.</h1>
            <p>Expressive design, unexpected shapes, and small details to make every corner feel like yours.</p>
            <a class="btn btn-inline" href="/products/create">Register product <span aria-hidden="true">↗</span></a>
        </div>

        <div class="hero-art" aria-label="Blue lamp illustration">
            <div class="lamp-shade"></div>
            <div class="lamp-stem"></div>
            <div class="lamp-base"></div>
        </div>
    </section>

    <section class="catalog-products" aria-labelledby="products-title">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Our selection</span>
                <h2 id="products-title">Products</h2>
            </div>
            <a class="text-link" href="/products/create">+ New product</a>
        </div>

        <div class="products">
            {{#if products}}
                {{#each products}}
                    <article class="product">
                        <div class="product-image">
                            <span class="tag">New</span>
                            {{#if this.image}}
                                <img src="{{this.image}}" alt="{{this.name}}" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=700&q=85';">
                            {{else}}
                                <img src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=700&q=85" alt="Lamp" loading="lazy">
                            {{/if}}
                        </div>
                        <div class="product-info">
                            <h3>{{this.name}}</h3>
                            <strong>R${{this.price}}</strong>
                            <p>{{this.description}}</p>
                            <div class="product-actions">
                                <a class="product-link" href="/products/{{this._id}}">View product <span aria-hidden="true">↗</span></a>
                                <a class="edit-link" href="/products/edit/{{this._id}}">Edit product</a>
                            </div>
                        </div>
                    </article>
                {{/each}}
            {{else}}
                <p class="empty-products">No products registered yet.</p>
            {{/if}}
        </div>
    </section>
</div>
